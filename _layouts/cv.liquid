---
layout: default
---
{% if page.cv_pdf %}
  {% if page.cv_pdf contains '://' %}
    {% assign cv_pdf_url = page.cv_pdf %}
  {% else %}
    {% assign cv_pdf_url = page.cv_pdf | prepend: 'assets/pdf/' | relative_url %}
  {% endif %}
{% endif %}

<div class="post cv-pdf-page">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if cv_pdf_url %}
        <a href="{{ cv_pdf_url }}" target="_blank" rel="noopener noreferrer" class="float-right">
          <i class="fa-solid fa-file-pdf"></i>
        </a>
      {% endif %}
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    {% if cv_pdf_url %}
      <div class="cv-pdf-actions">
        <a href="{{ cv_pdf_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm z-depth-0" role="button">
          Open PDF
        </a>
      </div>
      <object class="cv-pdf-viewer" data="{{ cv_pdf_url }}" type="application/pdf">
        <p>
          This browser cannot display the PDF inline.
          <a href="{{ cv_pdf_url }}" target="_blank" rel="noopener noreferrer">Open the CV PDF.</a>
        </p>
      </object>
    {% else %}
      {{ content }}
    {% endif %}
  </article>
</div>
