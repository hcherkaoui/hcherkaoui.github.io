<div class="papers">
  {% if site.data.paper_submissions != blank %}
    {% assign papers = site.data.paper_submissions %}
    {% assign papers_size = papers | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.papers.scrollable and papers_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% if include.limit and page.papers.limit %}
          {% assign papers_limit = page.papers.limit %}
        {% else %}
          {% assign papers_limit = papers_size %}
        {% endif %}
        {% for paper in papers limit: papers_limit %}
          <tr>
            <th scope="row" style="width: 20%">
              {% if paper.venue %}
                {{ paper.venue -}}
                {%- if paper.year %}, {% endif %}
              {% endif %}
              {{ paper.year }}
            </th>
            <td>
              <span class="paper-title">{{ paper.title }}</span>
              <span class="paper-links">
                {% if paper.paper_url %}
                  <a href="{{ paper.paper_url }}" target="_blank" rel="noopener noreferrer">paper</a>
                {% elsif paper.url %}
                  <a href="{{ paper.url }}" target="_blank" rel="noopener noreferrer">paper</a>
                {% endif %}
                {% if paper.code_url %}
                  <a href="{{ paper.code_url }}" target="_blank" rel="noopener noreferrer">code</a>
                {% endif %}
              </span>
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No papers so far...</p>
  {% endif %}
</div>
